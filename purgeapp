#!/usr/bin/env zsh
# purgeapp — plugin-based discovery & uninstall system for macOS
# https://github.com/SiavoshZarrasvand/homebrew-purgeapp

set -e

# Determine script root directory
SCRIPT_DIR="${0:A:h}"

if [[ -d "${SCRIPT_DIR}/lib" && -d "${SCRIPT_DIR}/plugins" ]]; then
  LIB_DIR="${SCRIPT_DIR}/lib"
  PLUGINS_DIR="${SCRIPT_DIR}/plugins"
elif [[ -d "${SCRIPT_DIR}/../libexec/lib" && -d "${SCRIPT_DIR}/../libexec/plugins" ]]; then
  LIB_DIR="${SCRIPT_DIR}/../libexec/lib"
  PLUGINS_DIR="${SCRIPT_DIR}/../libexec/plugins"
else
  echo "Error: Cannot locate purgeapp core libraries or plugins." >&2
  exit 1
fi

# Load core modules
source "${LIB_DIR}/artifact.zsh"
source "${LIB_DIR}/package_manager.zsh"
source "${LIB_DIR}/shell_config.zsh"
source "${LIB_DIR}/core.zsh"

# Load plugins
load_plugins "$PLUGINS_DIR"

# Run engine
run_purgeapp "$@"
